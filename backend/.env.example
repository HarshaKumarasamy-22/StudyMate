# App Settings
PROJECT_NAME="StudyMate API"
DEBUG=True
API_V1_STR="/api/v1"

# Database (PostgreSQL with pgvector)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/studymate_db"

# JWT Security
SECRET_KEY="replace-this-with-a-very-secure-random-secret-key"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=60

# OpenAI API Key (For embeddings and RAG answers)
OPENAI_API_KEY="your-openai-api-key-here"
OPENAI_MODEL="gpt-4o-mini"
EMBEDDING_MODEL="text-embedding-3-small"

# File Uploads
UPLOAD_DIR="./uploads"
MAX_FILE_SIZE_MB=15
